Option Explicit

Sub AggregateExcelData_AllFiles()

    Dim destWb As Workbook
    Dim sourceWb As Workbook
    Dim ws As Worksheet
    Dim foundCell As Range
    Dim tableRange As Range
    Dim lastRowDest As Long
    Dim folderPath As String
    Dim fileName As String
    Dim confirmMsg As VbMsgBoxResult

    ' --- ★★★ ここを書き換えてください ★★★ ---
    ' コピー先のExcelファイルの絶対パスを指定
    ' 例: "C:\Users\YourUser\Documents\集約データ.xlsx"
    Const DEST_FILE_PATH As String = "C:\Users\YourUser\Documents\集約データ.xlsx" ' <-- ここを実際のパスに修正

    ' コピー元のExcelファイルがあるフォルダの絶対パスを指定
    ' 例: "C:\Users\YourUser\Documents\データフォルダ\"
    Const SOURCE_FOLDER_PATH As String = "C:\Users\YourUser\Documents\データフォルダ\" ' <-- ここを実際のパスに修正
    ' --------------------------------------------

    ' 1. コピー先ファイルを開く
    On Error Resume Next ' ファイルが存在しない場合のエラーを捕捉
    Set destWb = Workbooks.Open(DEST_FILE_PATH)
    On Error GoTo 0 ' エラー処理をリセット

    If destWb Is Nothing Then
        MsgBox "指定されたコピー先ファイルが見つからないか、開けませんでした。パスを確認してください。" & vbCrLf & _
               "パス: " & DEST_FILE_PATH, vbCritical
        Exit Sub
    End If

    ' 処理開始の確認
    confirmMsg = MsgBox("以下の設定でExcelデータを集約します。" & vbCrLf & _
                        "集約先ファイル: " & destWb.Name & vbCrLf & _
                        "対象フォルダ: " & SOURCE_FOLDER_PATH & vbCrLf & _
                        "続行しますか？", vbQuestion + vbYesNo, "処理開始確認")

    If confirmMsg = vbNo Then
        MsgBox "処理がキャンセルされました。", vbInformation
        If Not destWb Is Nothing Then destWb.Close SaveChanges:=False ' 開いたファイルを閉じる
        Exit Sub
    End If

    ' フォルダパスの末尾が "\" で終わっていることを確認
    If Right(SOURCE_FOLDER_PATH, 1) <> "\" Then
        folderPath = SOURCE_FOLDER_PATH & "\"
    Else
        folderPath = SOURCE_FOLDER_PATH
    End If

    Application.ScreenUpdating = False ' 画面更新を停止し、処理を高速化

    ' フォルダ内の最初のExcelファイルを取得
    fileName = Dir(folderPath & "*.xls*")

    ' フォルダ内のすべてのExcelファイルをループ
    Do While fileName <> ""
        ' コピー先ファイル自身は開かないようにする (ファイル名とパスで比較)
        If StrComp(folderPath & fileName, DEST_FILE_PATH, vbTextCompare) <> 0 Then
            On Error Resume Next ' エラーが発生しても処理を続行
            Set sourceWb = Workbooks.Open(folderPath & fileName, ReadOnly:=True) ' 読み取り専用で開く
            On Error GoTo 0 ' エラー処理をリセット

            If Not sourceWb Is Nothing Then
                ' 各シートをループ
                For Each ws In sourceWb.Sheets
                    ' A列から「項目一覧」を検索
                    Set foundCell = ws.Columns("A:A").Find(What:="項目一覧", LookIn:=xlValues, LookAt:=xlPart, MatchCase:=False)

                    If Not foundCell Is Nothing Then
                        ' 「項目一覧」が見つかった場合、その表エリアを特定
                        ' foundCell (「項目一覧」があるセル) を含む行全体からEnd(xlToRight).End(xlDown)までを表の範囲と見なす
                        Set tableRange = ws.Range(foundCell.EntireRow.Cells(1, 1), foundCell.End(xlToRight).End(xlDown))

                        ' 表エリアをコピー
                        tableRange.Copy

                        ' コピー先ファイルにはりつけ
                        With destWb.Sheets(1) ' コピー先ファイルの最初のシートに貼り付け
                            lastRowDest = .Cells(.Rows.Count, "A").End(xlUp).Row

                            ' 既存データが全くない場合 (A1セルも空の場合)
                            If lastRowDest = 1 And IsEmpty(.Cells(1, "A").Value) Then
                                ' A1セルにシート名を記入
                                .Cells(1, "A").Value = "シート名: " & ws.Name
                                ' 次の行から表データを貼り付け (項目一覧の行から含む)
                                .Cells(2, "A").PasteSpecial xlPasteValues ' 値のみ貼り付け
                            Else
                                ' 既存データがある場合、一番下の行の次々行にシート名を記入
                                ' 例: lastRowDest が 10 なら 11 行目を空けて 12 行目にシート名、13 行目からデータ
                                .Cells(lastRowDest + 2, "A").Value = "シート名: " & ws.Name
                                ' その次の行から表データを貼り付け
                                .Cells(lastRowDest + 3, "A").PasteSpecial xlPasteValues ' 値のみ貼り付け
                            End If
                        End With
                        Application.CutCopyMode = False ' コピーモードを解除
                    End If
                Next ws
                sourceWb.Close SaveChanges:=False ' コピー元ファイルを保存せずに閉じる
            Else
                MsgBox fileName & " のオープンに失敗しました。スキップします。", vbExclamation
            End If
        End If
        ' 次のExcelファイルを取得
        fileName = Dir
    Loop

    Application.ScreenUpdating = True ' 画面更新を再開

    MsgBox "データの集約が完了しました。", vbInformation
End Sub
