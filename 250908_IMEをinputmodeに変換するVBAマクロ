Option Explicit

Sub フォルダ内ファイル処理()
    Dim fDialog As FileDialog
    Dim folderPath As String
    Dim fso As Object, folder As Object, file As Object
    Dim wb As Workbook, ws As Worksheet
    Dim execWs As Worksheet
    Dim r As Range, c As Range
    Dim lastRow As Long
    Dim changeLogRow As Long
    Dim execRow As Long
    Dim noCounter As Long
    Dim todayStr As String
    Dim commentText As String
    
    ' 実行内容シートを準備
    On Error Resume Next
    Set execWs = ThisWorkbook.Sheets("実行内容")
    If execWs Is Nothing Then
        Set execWs = ThisWorkbook.Sheets.Add
        execWs.Name = "実行内容"
    End If
    On Error GoTo 0
    execWs.Cells.ClearContents
    execWs.Range("A1:D1").Value = Array("No", "ブック名", "シート名", "変更内容")
    execRow = 2
    noCounter = 1
    
    ' フォルダ選択ダイアログ
    Set fDialog = Application.FileDialog(msoFileDialogFolderPicker)
    If fDialog.Show <> -1 Then Exit Sub
    folderPath = fDialog.SelectedItems(1)
    
    ' FSOでファイル走査
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set folder = fso.GetFolder(folderPath)
    
    todayStr = Format(Date, "yyyy/m/d")
    commentText = "「text」（全角入力）「numeric」（半角入力）から選択"
    
    For Each file In folder.Files
        If LCase(fso.GetExtensionName(file)) = "xls" Or LCase(fso.GetExtensionName(file)) = "xlsx" Then
            Set wb = Workbooks.Open(file.Path)
            
            '--- 「画面」を含むシートを処理 ---
            For Each ws In wb.Worksheets
                If InStr(ws.Name, "画面") > 0 Then
                    lastRow = ws.Cells(ws.Rows.Count, "R").End(xlUp).Row
                    For Each c In ws.Range("R1:R" & lastRow)
                        If c.Value <> "" Then
                            Select Case LCase(c.Value)
                                Case "ime"
                                    c.Value = "inputmode"
                                    c.Font.Color = RGB(0, 176, 240)
                                    On Error Resume Next
                                    c.ClearComments
                                    On Error GoTo 0
                                    c.AddComment text:=commentText
                                    With c.Comment.Shape
                                        .Height = Application.CentimetersToPoints(1.5)
                                        .Width = Application.CentimetersToPoints(12)
                                    End With
                                    With c.Comment.Shape.TextFrame.Characters.Font
                                        .Size = 14
                                        .Name = "游ゴシック"
                                    End With
                                    execWs.Cells(execRow, 1).Value = noCounter
                                    execWs.Cells(execRow, 2).Value = wb.Name
                                    execWs.Cells(execRow, 3).Value = ws.Name
                                    execWs.Cells(execRow, 4).Value = "IME → inputmode に変更"
                                    execRow = execRow + 1
                                    noCounter = noCounter + 1
                                    
                                Case "disabled"
                                    c.Value = "numeric"
                                    c.Font.Color = vbRed
                                    execWs.Cells(execRow, 1).Value = noCounter
                                    execWs.Cells(execRow, 2).Value = wb.Name
                                    execWs.Cells(execRow, 3).Value = ws.Name
                                    execWs.Cells(execRow, 4).Value = "disabled → numeric に変更"
                                    execRow = execRow + 1
                                    noCounter = noCounter + 1
                                    
                                Case "inactive"
                                    c.Value = "numeric"
                                    c.Font.Color = vbRed
                                    execWs.Cells(execRow, 1).Value = noCounter
                                    execWs.Cells(execRow, 2).Value = wb.Name
                                    execWs.Cells(execRow, 3).Value = ws.Name
                                    execWs.Cells(execRow, 4).Value = "inactive → numeric に変更"
                                    execRow = execRow + 1
                                    noCounter = noCounter + 1
                                    
                                Case "active"
                                    c.Value = "text"
                                    c.Font.Color = vbRed
                                    execWs.Cells(execRow, 1).Value = noCounter
                                    execWs.Cells(execRow, 2).Value = wb.Name
                                    execWs.Cells(execRow, 3).Value = ws.Name
                                    execWs.Cells(execRow, 4).Value = "active → text に変更"
                                    execRow = execRow + 1
                                    noCounter = noCounter + 1
                            End Select
                        End If
                    Next c
                End If
            Next ws
            
            '--- 更新履歴シートを処理 ---
            On Error Resume Next
            Set ws = wb.Sheets("更新履歴")
            On Error GoTo 0
            If Not ws Is Nothing Then
                lastRow = ws.Cells(ws.Rows.Count, "B").End(xlUp).Row
                changeLogRow = lastRow + 1
                ws.Cells(changeLogRow, 1).Value = ws.Cells(lastRow, 1).Value + 1
                ws.Cells(changeLogRow, 2).Value = todayStr
                ws.Cells(changeLogRow, 3).Value = "Ａ山Ｂ彦"
                ws.Cells(changeLogRow, 4).Value = ws.Name
                ws.Cells(changeLogRow, 5).Value = "IMEをinputmodeに変更"
                ws.Rows(changeLogRow).Font.Color = vbRed
            End If
            
            wb.Close SaveChanges:=True
        End If
    Next file
    
    MsgBox "処理が完了しました。", vbInformation
End Sub
