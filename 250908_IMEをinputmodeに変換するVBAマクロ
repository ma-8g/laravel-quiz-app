Option Explicit

Sub IMEコメント変換処理()
    Dim fDialog As FileDialog
    Dim folderPath As String
    Dim fso As Object, f As Object
    Dim wb As Workbook, ws As Worksheet
    Dim mainWb As Workbook
    Dim resultWs As Worksheet
    Dim lastRow As Long, nextRow As Long
    Dim cell As Range
    Dim com As Comment
    Dim fileName As String
    Dim no As Long
    
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    ' 実行ブックと記録用シートの準備
    Set mainWb = ThisWorkbook
    On Error Resume Next
    Set resultWs = mainWb.Sheets("実行内容")
    On Error GoTo 0
    If resultWs Is Nothing Then
        Set resultWs = mainWb.Sheets.Add
        resultWs.Name = "実行内容"
        resultWs.Range("A1:E1").Value = Array("No", "ブック名", "シート名", "", "")
    End If
    no = Application.WorksheetFunction.CountA(resultWs.Range("A:A"))
    
    ' フォルダ選択
    Set fDialog = Application.FileDialog(msoFileDialogFolderPicker)
    If fDialog.Show <> -1 Then Exit Sub
    folderPath = fDialog.SelectedItems(1)
    
    ' ファイルシステムオブジェクト
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    ' フォルダ内のExcelファイルを処理
    For Each f In fso.GetFolder(folderPath).Files
        If LCase(fso.GetExtensionName(f.Name)) Like "xls*" Then
            Set wb = Workbooks.Open(f.Path)
            fileName = wb.Name
            
            ' 「画面」を含むシート処理
            For Each ws In wb.Sheets
                If InStr(ws.Name, "画面") > 0 Then
                    ' R列を検索
                    For Each cell In ws.Range("R1", ws.Cells(ws.Rows.Count, "R").End(xlUp))
                        If cell.Value = "IME" Then
                            ' コメント削除＆追加
                            If Not cell.Comment Is Nothing Then cell.Comment.Delete
                            cell.AddComment _
                                "「active」「inactive」「disabled」から選択。" & vbCrLf & _
                                "inputmode は以下に読み替える。" & vbCrLf & vbCrLf & _
                                "IME　⇒　inputmode" & vbCrLf & _
                                "active　⇒　なし" & vbCrLf & _
                                "inactive　⇒　numeric"
                            With cell.Comment
                                .Shape.TextFrame.Characters.Font.Size = 14
                                .Shape.TextFrame.Characters.Font.Name = "游ゴシック"
                                .Shape.Height = Application.CentimetersToPoints(7.5)
                                .Shape.Width = Application.CentimetersToPoints(15)
                            End With
                            
                            ' 実行内容に記録
                            no = no + 1
                            resultWs.Cells(no, 1).Value = no
                            resultWs.Cells(no, 2).Value = fileName
                            resultWs.Cells(no, 3).Value = ws.Name
                        End If
                    Next cell
                    
                    ' 更新履歴シート追記
                    On Error Resume Next
                    Dim histWs As Worksheet
                    Set histWs = wb.Sheets("更新履歴")
                    On Error GoTo 0
                    If Not histWs Is Nothing Then
                        lastRow = histWs.Cells(histWs.Rows.Count, "B").End(xlUp).Row
                        nextRow = lastRow + 1
                        With histWs
                            .Cells(nextRow, 1).Value = .Cells(lastRow, 1).Value + 1
                            .Cells(nextRow, 2).Value = Format(Date, "yyyy/m/d")
                            .Cells(nextRow, 3).Value = "Ａ山Ｂ彦"
                            .Cells(nextRow, 4).Value = ws.Name
                            .Cells(nextRow, 5).Value = "IMEのコメントを変更"
                            
                            ' 赤字
                            .Range(.Cells(nextRow, 1), .Cells(nextRow, 5)).Font.Color = vbRed
                        End With
                    End If
                End If
            Next ws
            
            wb.Close SaveChanges:=True
        End If
    Next f
    
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    
    MsgBox "処理が完了しました。", vbInformation
End Sub
