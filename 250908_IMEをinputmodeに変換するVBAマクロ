Option Explicit

Sub フォルダ内ファイル変換処理()

    Dim fDialog As FileDialog
    Dim folderPath As String
    Dim fso As Object, f As Object, fFile As Object
    Dim wb As Workbook, ws As Worksheet
    Dim r As Range, cell As Range
    Dim lastRow As Long
    Dim logWs As Worksheet
    Dim logRow As Long
    Dim changeText As String
    Dim no As Long
    Dim beforeText As String, afterText As String
    
    ' 実行内容シートをセット
    Set logWs = ThisWorkbook.Sheets("実行内容")
    logRow = logWs.Cells(logWs.Rows.Count, "A").End(xlUp).Row + 1
    no = 1
    
    ' フォルダ選択ダイアログ
    Set fDialog = Application.FileDialog(msoFileDialogFolderPicker)
    If fDialog.Show <> -1 Then Exit Sub
    folderPath = fDialog.SelectedItems(1)
    
    ' FSOでフォルダ内ファイルを処理
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set f = fso.GetFolder(folderPath)
    
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    For Each fFile In f.Files
        If LCase(Right(fFile.Name, 4)) = "xlsx" Or LCase(Right(fFile.Name, 3)) = "xls" Then
            Set wb = Workbooks.Open(fFile.Path)
            
            For Each ws In wb.Worksheets
                If InStr(ws.Name, "画面") > 0 Then
                    lastRow = ws.Cells(ws.Rows.Count, "R").End(xlUp).Row
                    Set r = ws.Range("R1:R" & lastRow)
                    
                    For Each cell In r
                        If cell.Value <> "" Then
                            beforeText = cell.Value
                            afterText = ""
                            changeText = ""
                            
                            Select Case LCase(cell.Value)
                                Case "disabled", "inactive"
                                    afterText = "numeric"
                                    cell.Font.Color = vbRed
                                Case "active"
                                    afterText = "text"
                                    cell.Font.Color = vbRed
                                Case "ime"
                                    afterText = "inputmode"
                                    ' IMEの場合は色指定なし
                            End Select
                            
                            If afterText <> "" Then
                                cell.Value = afterText
                                changeText = "「" & beforeText & "」→「" & afterText & "」"
                                
                                ' ログ書き込み
                                logWs.Cells(logRow, 1).Value = no
                                logWs.Cells(logRow, 2).Value = wb.Name
                                logWs.Cells(logRow, 3).Value = ws.Name
                                logWs.Cells(logRow, 4).Value = changeText
                                
                                logRow = logRow + 1
                                no = no + 1
                            End If
                        End If
                    Next cell
                End If
            Next ws
            
            wb.Close SaveChanges:=True
        End If
    Next fFile
    
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    
    MsgBox "処理が完了しました。", vbInformation

End Sub
