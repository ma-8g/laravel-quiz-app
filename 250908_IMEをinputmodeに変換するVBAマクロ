Option Explicit

Sub フォルダ内ファイル処理()

    Dim fso As Object
    Dim folder As Object
    Dim file As Object
    Dim wb As Workbook
    Dim ws As Worksheet
    Dim execWs As Worksheet
    Dim targetFolder As String
    Dim lastRow As Long
    Dim writeRow As Long
    Dim checkCol As Range
    Dim cell As Range
    Dim sheetName As String
    Dim changeLog As String
    Dim execNo As Long
    
    ' 実行内容を記録するシート
    Set execWs = ThisWorkbook.Sheets("実行内容")
    execNo = Application.WorksheetFunction.Max(1, _
              Application.WorksheetFunction.Max(execWs.Cells(execWs.Rows.Count, 1).End(xlUp).Value, 0))
    
    ' フォルダを指定
    With Application.FileDialog(msoFileDialogFolderPicker)
        .Title = "処理対象のフォルダを選択してください"
        If .Show = -1 Then
            targetFolder = .SelectedItems(1)
        Else
            MsgBox "処理をキャンセルしました"
            Exit Sub
        End If
    End With
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set folder = fso.GetFolder(targetFolder)
    
    Application.ScreenUpdating = False
    Application.EnableEvents = False
    
    ' フォルダ内のExcelファイルを順次処理
    For Each file In folder.Files
        If (LCase(fso.GetExtensionName(file.Name)) = "xls" Or _
            LCase(fso.GetExtensionName(file.Name)) = "xlsx") _
            And file.Name <> ThisWorkbook.Name Then
            
            Set wb = Workbooks.Open(file.Path)
            
            ' シート名に「画面」を含むシートを処理
            For Each ws In wb.Sheets
                If InStr(ws.Name, "画面") > 0 Then
                    sheetName = ws.Name
                    changeLog = ""
                    
                    ' R列の最終行を取得
                    lastRow = ws.Cells(ws.Rows.Count, "R").End(xlUp).Row
                    Set checkCol = ws.Range("R1:R" & lastRow)
                    
                    For Each cell In checkCol
                        If cell.Value = "disabled" Then
                            cell.Value = "numeric"
                            cell.Font.Color = vbRed
                            changeLog = changeLog & "disabled→numeric;"
                        ElseIf cell.Value = "inactive" Then
                            cell.Value = "numeric"
                            cell.Font.Color = vbRed
                            changeLog = changeLog & "inactive→numeric;"
                        ElseIf cell.Value = "active" Then
                            cell.Value = "text"
                            cell.Font.Color = vbRed
                            changeLog = changeLog & "active→text;"
                        ElseIf cell.Value = "IME" Then
                            cell.Value = "inputmode"
                            changeLog = changeLog & "IME→inputmode;"
                        End If
                    Next cell
                    
                    ' 更新履歴シート更新
                    On Error Resume Next
                    Set ws = wb.Sheets("更新履歴")
                    On Error GoTo 0
                    
                    If Not ws Is Nothing Then
                        lastRow = ws.Cells(ws.Rows.Count, "B").End(xlUp).Row
                        ws.Cells(lastRow + 1, "A").Value = ws.Cells(lastRow, "A").Value + 1
                        ws.Cells(lastRow + 1, "B").Value = Date
                        ws.Cells(lastRow + 1, "C").Value = "Ａ山Ｂ彦"
                        ws.Cells(lastRow + 1, "D").Value = sheetName
                        ws.Cells(lastRow + 1, "E").Value = "IMEをinputmodeに変更"
                    End If
                    
                    ' 実行内容シートに記録
                    If changeLog <> "" Then
                        writeRow = execWs.Cells(execWs.Rows.Count, 1).End(xlUp).Row + 1
                        execWs.Cells(writeRow, 1).Value = execNo
                        execWs.Cells(writeRow, 2).Value = wb.Name
                        execWs.Cells(writeRow, 3).Value = sheetName
                        execWs.Cells(writeRow, 4).Value = changeLog
                        execNo = execNo + 1
                    End If
                    
                End If
            Next ws
            
            wb.Close SaveChanges:=True
        End If
    Next file
    
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    
    MsgBox "処理が完了しました"
    
End Sub
