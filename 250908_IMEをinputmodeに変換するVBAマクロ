Option Explicit

Sub 変換処理実行()

    Dim wb As Workbook
    Dim ws As Worksheet
    Dim fso As Object
    Dim fld As Object
    Dim fil As Object
    Dim myPath As String
    Dim lastRow As Long
    Dim tgtRow As Long
    Dim execWs As Worksheet
    Dim cnt As Long
    Dim c As Range
    Dim newVal As String
    Dim logMsg As String
    Dim histWs As Worksheet
    Dim histRow As Long
    
    '--- 実行結果記録用シート
    Set execWs = ThisWorkbook.Sheets("実行内容")
    cnt = execWs.Cells(Rows.Count, 1).End(xlUp).Row
    If cnt = 1 And execWs.Range("A1").Value = "" Then cnt = 0
    
    '--- 対象フォルダ指定（適宜変更）
    myPath = "C:\Temp\Test"  ' ★変更してください
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set fld = fso.GetFolder(myPath)
    
    For Each fil In fld.Files
        If (Right(fil.Name, 4) = "xlsx" Or Right(fil.Name, 3) = "xls") And fil.Name <> ThisWorkbook.Name Then
            
            Set wb = Workbooks.Open(fil.Path)
            
            '--- シート名に「画面」を含むシート処理
            For Each ws In wb.Worksheets
                If InStr(ws.Name, "画面") > 0 Then
                    
                    lastRow = ws.Cells(ws.Rows.Count, "R").End(xlUp).Row
                    For Each c In ws.Range("R1:R" & lastRow)
                        If c.Value <> "" Then
                            newVal = ""
                            logMsg = ""
                            
                            Select Case LCase(c.Value)
                                Case "disabled"
                                    newVal = "numeric"
                                    c.Font.Color = vbRed
                                    logMsg = "disabled → numeric"
                                Case "inactive"
                                    newVal = "numeric"
                                    c.Font.Color = vbRed
                                    logMsg = "inactive → numeric"
                                Case "active"
                                    newVal = "text"
                                    c.Font.Color = vbRed
                                    logMsg = "active → text"
                                Case "ime"
                                    newVal = "inputmode"
                                    c.Font.Color = vbBlue
                                    logMsg = "IME → inputmode"
                            End Select
                            
                            If newVal <> "" Then
                                c.Value = newVal
                                cnt = cnt + 1
                                execWs.Cells(cnt, 1).Value = cnt
                                execWs.Cells(cnt, 2).Value = wb.Name
                                execWs.Cells(cnt, 3).Value = ws.Name
                                execWs.Cells(cnt, 4).Value = logMsg
                            End If
                        End If
                    Next c
                    
                    '--- 更新履歴シート処理
                    On Error Resume Next
                    Set histWs = wb.Sheets("更新履歴")
                    On Error GoTo 0
                    If Not histWs Is Nothing Then
                        histRow = histWs.Cells(histWs.Rows.Count, "B").End(xlUp).Row + 1
                        histWs.Cells(histRow, 1).Value = histWs.Cells(histRow - 1, 1).Value + 1
                        histWs.Cells(histRow, 2).Value = Format(Date, "yyyy/mm/dd")
                        histWs.Cells(histRow, 3).Value = "Ａ山Ｂ彦"
                        histWs.Cells(histRow, 4).Value = ws.Name
                        histWs.Cells(histRow, 5).Value = "IMEをinputmodeに変更"
                        histWs.Rows(histRow).Font.Color = vbRed
                    End If
                    
                End If
            Next ws
            
            wb.Close SaveChanges:=True
            Set histWs = Nothing
            
        End If
    Next fil
    
    MsgBox "処理が完了しました。"
    
End Sub
